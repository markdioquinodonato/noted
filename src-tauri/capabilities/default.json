{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Least-privilege permissions shared by the desktop and Android apps.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:allow-default-urls",
    "opener:allow-open-url",
    "dialog:allow-save",
    "dialog:allow-message",
    "fs:allow-write-file"
  ]
}
