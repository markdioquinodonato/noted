{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Least-privilege permissions for the Noted main window.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:allow-default-urls",
    "opener:allow-open-url",
    "dialog:allow-save",
    "dialog:allow-message",
    "fs:allow-write-file",
    "process:allow-restart",
    "updater:allow-check",
    "updater:allow-download-and-install"
  ]
}
